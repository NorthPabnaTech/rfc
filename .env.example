# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string (Atlas or self-hosted) and database name
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=rfc_gadget

# Long random string (>= 32 chars) used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Cloudinary credentials (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public cloud name, used by the browser to build optimized image URLs
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Public site URL (used for SEO metadata, sitemap and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Realtime notifications — Pusher Channels (pusher.com → Channels → App Keys).
# Optional: without them the notification bell polls every 30 seconds.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# System notifications (Web Push) — desktop/phone alerts even when the site is
# closed. Free, no third-party account. Generate once with:
#   npx web-push generate-vapid-keys
# Optional: without them only the in-page bell is used.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rfcgadget.com

# Outgoing email (password-reset links) over SMTP. Free with Gmail:
#   1. Turn on 2-Step Verification for the Gmail account
#   2. myaccount.google.com/apppasswords → create an App Password
#   3. SMTP_USER = the Gmail address, SMTP_PASS = the 16-character App Password
# Gmail allows ~500 emails/day. Optional in development: without SMTP_USER /
# SMTP_PASS the reset link is printed to the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional sender, e.g. "RFC Gadget <you@gmail.com>" (defaults to SMTP_USER)
MAIL_FROM=

# First admin account, created by `npm run seed`
ADMIN_NAME=RFC Gadget Admin
ADMIN_EMAIL=admin@rfcgadget.com
ADMIN_PASSWORD=
